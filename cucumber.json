{

  "default": {

    "paths": ["features/**/*.feature"],

    "tags": "@test2",

    "parallel": 2,

    "require": [

      "features/step_definitions/**/*.ts",

      "features/support/hooks.ts"

    ],

    "requireModule": ["ts-node/register/transpile-only"],

    "dryRun": false,

    "publishQuiet": true,

    "formatOptions": {

      "snippetInterface": "async-await",

      "resultsDir": "allure-results"

    },

    "format": [

      "progress",

      "allure-cucumberjs/reporter"

    ]

  }

}

 