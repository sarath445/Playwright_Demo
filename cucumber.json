{
  "default": {
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "paths": [
      "features/**/*.feature"
    ],
    "publishQuiet": true,
    "dryRun": false,
    "tags": "@web",
    "parallel":2,
    "require": [
      "features/step_definitions/**/*.ts",
      "features/support/hooks.ts"
    ],
    "requireModule": [
      "ts-node/register/transpile-only"
    ]
  }
}
